# Runtime environment. APP_VARIANT must be development, staging, or production.
APP_VARIANT=development
APP_DOMAIN=apnatask.pk
APP_LINK_DOMAIN=app.apnatask.pk
EAS_OWNER=
EAS_PROJECT_ID=

# EXPO_PUBLIC values are embedded in the application and must never be secrets.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_WS_BASE_URL=ws://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Public, URL/application-restricted Mapbox token. Map and geocoding usage is billable.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Optional custom Mapbox Studio style JSON URL; token-derived Streets is the default.
EXPO_PUBLIC_MAP_STYLE_URL=
EXPO_PUBLIC_SENTRY_DSN=

# Build-only secrets belong in EAS environment variables, not this file.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
