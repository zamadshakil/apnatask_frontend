    "@tanstack/react-query-persist-client": "^5.101.4",
    "caniuse-lite": "^1.0.30001799",
    "expo": "~57.0.19",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-image-manipulator": "~57.0.15",
    "expo-image-picker": "~57.0.15",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.15",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.3.6",
    "jest-expo": "~57.0.5",
    "lucide-react-native": "^1.21.0",
    "maplibre-gl": "^5.24.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^17.0.11",
    "react-native": "^0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.7",
    "expo-doctor": "^1.20.2",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.5",
    "msw": "^2.3.0",
    "openapi-typescript": "^7.13.0",
    "react-native-worklets": "0.10.1",
    "react-test-renderer": "19.2.3",
    "sharp": "^0.35.4",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "node scripts/validate-hosted-env.mjs && expo export --clear --platform web --output-dir dist-web",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "test:e2e": "jest --testPathPattern=__tests__/e2e --runInBand",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "brand:verify": "node scripts/verify-brand-assets.mjs",
    "api:generate": "openapi-typescript ../apnatask/openapi/openapi.json -o src/api/schema.d.ts",
    "check": "npm run brand:verify && npm run typecheck && npm test -- --runInBand"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "overrides": {
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5"
  },
  "private": true
}
